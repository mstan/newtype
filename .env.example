# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# report: alert only (start here). enforce: take action.
NEWTYPE_MODE=report

# Where alerts and bot-add notices go, per server: guildId:channelId,guildId:channelId
# The server owner is always DMed alerts as well.
NEWTYPE_LOG_CHANNELS=

# Members count as new, and can't hold privileged roles or add bots, if their Discord
# account is younger than NEWTYPE_NEW_ACCOUNT_DAYS or they joined the server less than
# NEWTYPE_NEW_MEMBER_HOURS ago (defaults 7 days and 24 hours)
NEWTYPE_NEW_ACCOUNT_DAYS=7
NEWTYPE_NEW_MEMBER_HOURS=24

# Optional per-action limits from `npm run calibrate`, as JSON. Omitted actions keep their defaults.
# NEWTYPE_RATE_LIMITS={"ChannelDelete":{"limit":4,"windowSeconds":60}}
